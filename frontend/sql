-- -----------------------------------------------------
-- 0. Database Creation
-- -----------------------------------------------------
CREATE DATABASE IF NOT EXISTS pharmacy;
USE pharmacy;

-- -----------------------------------------------------
-- 1. Users Table
-- -----------------------------------------------------
CREATE TABLE Users (
    user_id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(50) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL, -- Use salted hash (bcrypt/argon2)
    full_name VARCHAR(100) NOT NULL,
    phone_number VARCHAR(20) UNIQUE,
    role ENUM('admin', 'staff') NOT NULL DEFAULT 'staff',
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

    INDEX idx_username (username),
    INDEX idx_role (role)
) ENGINE=InnoDB;

-- -----------------------------------------------------
-- 2. Medicines Table
-- -----------------------------------------------------
CREATE TABLE Medicines (
    medicine_id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(150) NOT NULL,
    batch_strength VARCHAR(100),
    quantity INT NOT NULL DEFAULT 0,
    expiry_date DATE,
    unit_price DECIMAL(12, 2) NOT NULL,
    supplier VARCHAR(100),
    is_deleted BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

    INDEX idx_name (name),
    INDEX idx_expiry_date (expiry_date),
    INDEX idx_quantity (quantity)
) ENGINE=InnoDB;

-- -----------------------------------------------------
-- 3. Sales Table
-- -----------------------------------------------------
CREATE TABLE Sales (
    sale_id INT AUTO_INCREMENT PRIMARY KEY,
    medicine_id INT NOT NULL,
    medicine_name VARCHAR(150),
    quantity_sold INT NOT NULL,
    unit_price DECIMAL(12, 2) NOT NULL,
    total_amount DECIMAL(14, 2) NOT NULL,
    sold_by_user_id INT,
    date_sold DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (medicine_id) REFERENCES Medicines(medicine_id)
        ON DELETE RESTRICT ON UPDATE CASCADE,
    FOREIGN KEY (sold_by_user_id) REFERENCES Users(user_id)
        ON DELETE SET NULL ON UPDATE CASCADE,

    INDEX idx_date_sold (date_sold),
    INDEX idx_medicine_user (medicine_id, sold_by_user_id)
) ENGINE=InnoDB;

-- -----------------------------------------------------
-- 4. AccessLog Table (Audit Trail)
-- -----------------------------------------------------
CREATE TABLE AccessLog (
    log_id INT AUTO_INCREMENT PRIMARY KEY,
    timestamp DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    username VARCHAR(50) NOT NULL,
    action ENUM('login', 'logout', 'password_reset', 'failed_login_attempt') NOT NULL,
    status ENUM('success', 'failed') NOT NULL,
    ip_address VARCHAR(45),
    user_id INT,

    FOREIGN KEY (user_id) REFERENCES Users(user_id)
        ON DELETE SET NULL ON UPDATE CASCADE,

    INDEX idx_timestamp (timestamp DESC),
    INDEX idx_username_action (username, action),
    INDEX idx_user_id (user_id)
) ENGINE=InnoDB;
